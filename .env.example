# Supabase — get from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Spotify Developer App — https://developer.spotify.com/dashboard
# Requires Spotify Premium account for Developer Mode (Feb 2026 policy)
# Used for: user login, track search, album art, genres
# Add both redirect URIs in Spotify Developer Dashboard:
#   - Local:  http://localhost:5173/callback
#   - Pages:  https://YOUR_GITHUB_USERNAME.github.io/itoldyouso/callback
VITE_SPOTIFY_CLIENT_ID=your-client-id
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# YouTube Data API v3 — https://console.cloud.google.com
# Used for: video selection in claims, view count validation
# Free tier: 10,000 units/day (search = 100 units, video stats = 1 unit)
VITE_YOUTUBE_API_KEY=your-youtube-api-key

# Last.fm API — https://www.last.fm/api/account/create
# Used for: artist listener count, total play count (replaces Spotify popularity/followers)
# Free, no rate limit for personal projects, no OAuth required
VITE_LASTFM_API_KEY=your-lastfm-api-key
