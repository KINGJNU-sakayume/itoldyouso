# Everything below is optional.
#
# Without these values the app keeps all data in the browser (localStorage)
# and every feature works. Set them to sync the same log across devices via
# Supabase — see README → "클라우드 동기화 (선택)".
#
# For GitHub Pages builds, add the same two names as repository secrets
# (Settings → Secrets and variables → Actions); the workflow passes them in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
